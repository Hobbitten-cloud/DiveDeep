@model Root

<form method="post">
    <label>Skriv latitude her:</label>
    <input type="number" step="any" name="latitude" />

    <label>Skriv longitude her:</label>
    <input type="number" step="any" name="longitude" />
    <button type="submit">Send</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red;">@ViewBag.Error</p>
}

@if (Model != null)
{
    <h2>Vejrinformation</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Dato</th>
                <th>Nedbør (sum)</th>
                <th>Temp min</th>
                <th>Temp max</th>
                <th>Vind (max 10m)</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.daily.time.Count; i++)
        {
            <tr>
                <td>@Model.daily.time[i]</td>
                <td>@Model.daily.precipitation_sum[i]</td>
                <td>@Model.daily.temperature_2m_min[i]</td>
                <td>@Model.daily.temperature_2m_max[i]</td>
                <td>@Model.daily.wind_speed_10m_max[i]</td>
            </tr>
        }
        </tbody>
    </table>

