@model Root

<form method="post">
	<h2>Vejrinformation</h2>

	<h6>Skriv længde- og breddegrad for det sted, du ønsker at se vejrudsigten.</h6><br />

	<label>Længdegrad:</label>
	<input type="text" step="any" name="latitude"/>

	<label>Breddegrad:</label>
	<input type="text" step="any" name="longitude"/>
	<button type="submit">Send</button><br /><br />
</form>

@if (ViewBag.Error != null)
{
	<p style="color:red;">@ViewBag.Error</p>
}

@if (Model != null)
{
	<table class="table">
		<thead>
			<tr>
				<th>Dato</th>
				<th>Nedbør</th>
				<th>Temperatur</th>
				<th>Vindhastighed</th>
				<th>Bølgehøjde</th>
				<th>Risiko for lyn</th>
				<th>Dykkerforhold</th>
				<th>Dragtanbefaling</th>
			</tr>
		</thead>
		<tbody>
			@for (int i = 0; i < Model.hourly.time.Count; i++)
			{
				<tr>
					<td>@Model.hourly.time[i].ToString("dd.MM.yyyy kl. HH:mm")</td>
					<td>@Model.hourly.precipitation[i] mm</td>
					<td>@Model.hourly.temperature_2m[i]°</td>
					<td>@Model.hourly.wind_speed_10m[i] m/s</td>
					<td>@Model.hourly.wave_height[i] m</td>
					@if (Model.hourly.weathercode[i] == 95 || Model.hourly.weathercode[i] == 96 || Model.hourly.weathercode[i] == 99)
					{
						<td>Ja</td>
					}
					else
					{
						<td>Nej</td>
					}

					@if (Model.hourly.wind_speed_10m[i] > 8 && Model.hourly.wave_height[i] > 1.5 && Model.hourly.precipitation[i] < 2)
					{
						<td>Gode</td>
					}
					else 
					{
						<td>Dårlige!</td>
					}

					@if (Model.hourly.temperature_2m[i] > 24)
					{
						<td>Våddragt (7 mm)</td>
					}
					else if (Model.hourly.temperature_2m[i] >= 18 && Model.hourly.temperature_2m[i] <= 24)
					{
						<td>Våddragt (5 mm)</td>
					}
					else if (Model.hourly.temperature_2m[i] >= 10 && Model.hourly.temperature_2m[i] <= 18)
					{
						<td>Våddragt (3 mm)</td>
					}
					else 
					{
						<td>Tørdragt</td>
					}
				</tr>
			}
		</tbody>
	</table>
}