@model Root

<form method="post">
    <label>Skriv lat her:</label>
    <input type="number" step="any" name="lat" />

    <label>Skriv lng her:</label>
    <input type="number" step="any" name="lng" />
    <button type="submit">Send</button> 
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red;">@ViewBag.Error</p>
}

@if (Model != null)
{
    <h2>Vejrinformation</h2>
    @foreach (var hour in Model.Hours.Take(5))
    {
        <p>Time: @hour.Time</p>
        <p>Vindhastighed: @hour.WindSpeed["noaa"] m/s</p>
        <p>Bølgehøjde: @hour.WaveHeight["noaa"] m</p>
        <p>Nedbør: @hour.Precipitation["noaa"] mm</p>
        <hr />
    }
}