@model Root

<form method="post">
	<label>Skriv latitude her:</label>
	<input type="text" step="any" name="latitude" />

	<label>Skriv longitude her:</label>
	<input type="text" step="any" name="longitude" />
	<button type="submit">Send</button>
</form>

@if (ViewBag.Error != null)
{
	<p style="color:red;">@ViewBag.Error</p>
}

@if (Model != null)
{
	<h2>Vejrinformation</h2>

	<table class="table">
		<thead>
			<tr>
				<th>Dato</th>
				<th>Nedbør</th>
				<th>Temp</th>
				<th>Vind (max 10m)</th>
				<th>Vejr</th>
			</tr>
		</thead>
		<tbody>
			@for (int i = 0; i < Model.hourly.time.Count; i++)
			{
				<tr>
					<td>@Model.hourly.time[i]</td>
					<td>@Model.hourly.precipitation[i]</td>
					<td>@Model.hourly.temperature_2m[i]</td>
					<td>@Model.hourly.wind_speed_10m[i]</td>
					<td>@Model.hourly.weathercode[i]</td>
				</tr>
			}
		</tbody>
	</table>
}