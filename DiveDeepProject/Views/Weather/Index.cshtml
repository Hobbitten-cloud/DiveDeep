    <p>@Model.daily.temperature_2m_max</p>
    <p>@Model.daily.wind_speed_10m_max</p> *@

    <div class="card">
        @foreach(var weatherinfo in Model.Dailys)
        {
            <div class="card-body">
                <p>@weatherinfo.precipitation_sum</p>
                <p>@weatherinfo.wind_speed_10m_max</p>
                <p>@weatherinfo.temperature_2m_min</p>
                <p>@weatherinfo.temperature_2m_max</p>
            </div>
        }
    </div>

