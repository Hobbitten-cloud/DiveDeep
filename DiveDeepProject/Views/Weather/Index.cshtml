@model Root

@{
	ViewData["Title"] = "Weather Information";
}

<form>
	<label>Skriv lat her:</label>
	<input type="number" id="lat"/>

	<label>Skriv lng her:</label>
	<input type="number" id="lng"/>
	<button type="submit">Send</button> 
</form>

@if (ViewBag.Error != null){
	<p style="color:red;">@ViewBag.Error</p>
}

@if (Model != null)
{
	<h2>Vejrinformation</h2>
	@foreach (var hour in Model.Hours)
	{
		<p>Time: @hour.Time</p>
		<p>Vindhastighed: @hour.WindSpeed</p>
		<p>Bølgehøjde: @hour.WaveHeight</p>
		<p>Nedbør: @hour.Precipitation</p>
		<hr />
	}
}