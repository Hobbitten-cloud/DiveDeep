@using DiveDeepProject.Models
@model List<Category>

<div style="display:flex; justify-content:space-between; align-items:center;">
	<h2 class="mb-4">Kategorier</h2>
	<input type="text" placeholder="Søg..." style="gap: "/>
</div>

@if (Model != null && Model.Count() > 0)
{
	<div class="d-flex flex-wrap gap-3 mb-5">
		@foreach (var category in Model)
		{
				<button type="button" class="btn btn-primary px-4">@category.Name</button>
		}
	</div>
}

<h2 class="mb-4">Udstyr</h2>

@if (Model != null && Model.Count() > 0)
{
	<div class="row g-4" style="gap: 25px">
		@* Implement selected category so the product display can change. *@
		@* Index 0 and 1 will not work as the products are not implemented yet *@
		@foreach (var product in Model[4].products)
		{
			<div class="card" style="width: 18rem;">
				<img src="@product.ImagePath" class="card-img-top" alt="...">
				<div class="card-body">
					<p class="card-text">@product.Brand</p>
					<p class="card-text" style="font-weight: bold">@product.PricePerDay DKK pr. dag</p>
				</div>
			</div>
		}
	</div>
}