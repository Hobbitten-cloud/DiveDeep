@model CategoryPageViewData

<div style="display:flex; justify-content:space-between; align-items:center;">
	<h2 class="mb-4">Kategorier</h2>
	<form asp-controller="Categories" asp-action="Index" method="get" class="d-flex gap-2">
		<input type="hidden" name="id" value="@Model?.SelectedCategoryId" />
		<input type="text" name="searchString" value="@Model?.SearchString" placeholder="Søg..." class="form-control" />
		@* <button type="submit" class="btn btn-secondary">Filter</button> *@
	</form>
</div>

@if (Model != null && Model.categories.Count() > 0)
{
	<div class="d-flex flex-wrap gap-3 mb-5">
		@foreach (var category in Model.categories)
		{
				<a type="button" class="btn btn-primary px-4"
				asp-controller="Categories" asp-action="Index" asp-route-id="@category.Id">@category.Name</a>
		}
	</div>
}

<h2 class="mb-4">Udstyr</h2>
@if (Model != null && Model.categories.Count() > 0)
{
	<div class="row g-4" style="gap: 25px">
		@if (Model.SelectedCategoryId == 2)
		{
			@foreach (var product in Model.snorkelPackages)
			{
				
				<div class="card" style="width: 18rem;">
					<a class="btn btn-link" style="text-decoration: none; color: black;" asp-controller="Package" asp-action="ShowPackage" asp-route-id="@product.Id">

                    <img src="~/@product.ImagePath" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-text">@product.Name</h5>
							<p class="card-text">@product.Description</p>
							<p class="card-text" style="font-weight: bold">@product.TotalPricePerDay DKK pr. dag</p>
						</div>
					</a>
				</div>
			}
		}
		else if (Model.SelectedCategoryId == 1)
		{
			@foreach (var product in Model.completePackages)
			{

				<div class="card" style="width: 18rem;">
					<a class="btn btn-link" style="text-decoration: none; color: black;" asp-controller="Package" asp-action="ShowPackage" asp-route-id="@product.Id">

                    <img src="~/@product.ImagePath" class="card-img-top" alt="...">
						<div class="card-body">
							<h5 class="card-text">@product.Name</h5>
							<p class="card-text">@product.Description</p>
							<p class="card-text" style="font-weight: bold">@product.TotalPricePerDay DKK pr. dag</p>
						</div>
					</a>
				</div>
			}
		}
		else
		{
			@foreach (var product in Model.categories.Where(c => c.Id == Model.SelectedCategoryId).ToList()[0].products)
			{
				<div class="card" style="width: 18rem;">
					<a class="btn btn-link" style="text-decoration: none; color: black;" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"> 
					
                    <img src="~/@product.ImagePath" class="card-img-top" alt="...">
					<div class="card-body"> 
						<h5 class="card-text">@product.Brand</h5>
						<p class="card-text" 1em> @product.Model</p>
						<p class="card-text">@product.Description</p>
						<p class="card-text" style="font-weight: bold">@product.PricePerDay DKK pr. dag</p>
						</div>
					

				</a>
			</div>
		}
		}
	</div>
}