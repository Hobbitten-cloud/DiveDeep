@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Mania</title>
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.css" />
</head>
<body>
    <header>
        <div>
            @RenderSection("navbar", false)
            <div class="infobanner bg-warning text-center">Alle reservationer afhentes hos DiveDeep Odense, Hans Hansens Vej 1</div>
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav d-flex w-100">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="home" asp-action="index">
                                    <img src="~/lib/Public/LOGO.png" alt="Logo" height="auto" width="35px">
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="home" asp-action="index">Udstyr</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="movies" asp-action="index">Kontakt</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="movies" asp-action="index">Om os</a>
                            </li>
                            <li class="nav-item ms-auto">
                                <a class="nav-link" asp-controller="movies" asp-action="index">
                                    <img src="~/lib/Public/ShoppingCart.png" alt="ShoppingCart" height="auto" width="35px">
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <hr />
        </div>
    </header>
    <div class="container">
        <div>
            @RenderBody()
        </div>
    </div>

    <footer>
        <hr />
        <div class="bg-info">
            <h3>Kontakt os</h3>
            <p>DiveDeep A/S</p>
            <p>Hans Hansens Vej 1</p>
            <p>5000 Odense C</p>
            <p>Danmark</p>
            <p>Telefonnummer: 88 88 88 88</p>
            <p>E-mail: info@diving2000.dk</p>
            <p>CVR: 00000000</p>
        </div>
    </footer>
</body>
</html>