@model DiveDeepProject.Models.DivingSuit

<div class="product divingsuit">
	<img src="~/@Model.ImagePath" alt="@Model.Brand @Model.Model" />
	<h3>@Model.Brand</h3>
	<h4>@Model.Model</h4>
	<p>@Model.Description</p>
	<p>Type: @Model.Type</p>
	<p>Køn: @Model.Gender</p>
	<p>Tykkelse: @Model.Thickness</p>
	<p>Størrelse: @Model.Size</p>
	<p>Pris pr. dag: @Model.PricePerDay kr</p>
	<button>Læg i indkøbskurv</button>
</div>