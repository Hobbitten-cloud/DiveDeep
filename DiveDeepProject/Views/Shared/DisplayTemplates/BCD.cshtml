@model DiveDeepProject.Models.BCD

<div>
	<div>
		<img src="~/@Model.ImagePath" alt="@Model.Brand @Model.Model" />
	</div>
	<div class="product bcd" style="display: inline-block; vertical-align: top; padding-left: 18px;">
		<h3>@Model.Brand</h3>
		<h4>@Model.Model</h4>
		<p>@Model.Description</p>
		<p>Størrelse: @Model.Size</p>
		<p>Pris pr. dag: @Model.PricePerDay kr</p>
		<button>Læg i indkøbskurv</button>
	</div>
</div>