@model DiveDeepProject.Models.Regulatorset

<div class="product regulatorset">
	<img src="~/@Model.ImagePath" alt="@Model.Brand" />
	<h3>@Model.Brand</h3>
	<p>@Model.Description</p>
	<p>1. trin: @Model.FirstStep</p>
	<p>2. trin: @Model.SecondStep</p>
	<p>Octopus: @Model.Octopus</p>
	<p>Pris pr. dag: @Model.PricePerDay kr</p>
	<button>Læg i indkøbskurv</button>
</div>