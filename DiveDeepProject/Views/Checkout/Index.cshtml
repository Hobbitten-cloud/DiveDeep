@model CheckOutPageViewData

@section navbar {

}



<div class="SectionsContainer" style="display: flex; gap: 20px; justify-content: center; align-items: flex-start; padding-left: 50px;">
	<section id="LeftSection" style="flex: 1; padding: 20px;">
		<form method="post" asp-action="Reserve">
			<div class="text-danger" asp-validation-summary="All"></div>
			
			<h3>Bestilling</h3>

			<Label>Kommentarer</Label><br>
			<input type="text" asp-for="Receipt.Comment"><br><br>

			<span class="text-danger" asp-validation-for="Receipt.HasDivingCertificat"></span>
			<input type="checkbox" class="form-check" id="checkbox" asp-for="Receipt.HasDivingCertificat">
			<div id="terms-and-conditions">Jeg har dykkercertifikat.</div><br><br>

			<span class="text-danger" asp-validation-for="Receipt.AcceptedTerms"></span>
			<input type="checkbox" class="form-check" id="checkbox" asp-for="Receipt.AcceptedTerms">
			<div id="terms-and-conditions">Jeg accepterer handels- og leveringsbetingelserne.</div><br><br>

			<button class="btn-primary" type="submit">Reserver</button>
		
			
		</form>
	</section>

<div>
	<form>
		<section id="RightSection" style="background-color: lightgray; flex: 1; padding: 20px; margin-top: 45px;">
			@foreach (var item in Basket.GetProducts())
			{
					<div class="product-container">
						<p>Brand : @item.Brand</p>
						<p>Mærke : @item.Description</p>
						<p>Antal :<a class="btn" asp-controller="Checkout" asp-action="Remove" asp-route-id="@item.Id" asp-route-type="product">-</a>@Basket.GetAmountOfSpecificProducts(item)<a class="btn" asp-controller="Checkout" asp-action="Add" asp-route-id="@item.Id" asp-route-type="product">+</a></p>
						<p>Pris  : @item.PricePerDay DKK</p>
					</div>

				<br>
			}
			<br>
			@foreach (var item in Basket.GetPackages())
			{
					
				<div class="product-container">
					<p>Brand : @item.Name</p>
					<p>Mærke : @item.Description</p>
					<p>Antal :<a class="btn" asp-controller="Checkout" asp-action="Remove" asp-route-id="@item.Id" asp-route-type="product">-</a>@Basket.GetAmountOfSpecificPackages(item)<a class="btn" asp-controller="Checkout" asp-action="Add" asp-route-id="@item.Id" asp-route-type="product">+</a></p>
					<p>Pris  : @item.TotalPricePerDay DKK</p>
				</div>


				<br>
			}
			<p>Start dato: @Model.Receipt.PickupDate</p>
				<p text-decoration="underline">Slut dato: @Model.Receipt.ReturnDate</p>
			<label>I alt</label>
			<p id="price-text">@Basket.GetTotalPricePerDay() DKK</p>
		</section>
	</form>
	</div>
</div>

<style>
	label{
		font-weight: bold;
		font-size: 16px;
	}

	#checkbox {
		display: inline-block;
	}

	#terms-and-conditions {
		display: inline-block;
	}

		
	.product-container {
		border: 2px solid black;
		border-radius: 20px;
		padding: 10px;
		margin: 10px;
		background : white;

	}

	.product-container p {
		border-bottom : 2px solid black;
			
	}

	.product-container button {
		border-radius: 10px;
	}

	
</style>

