@model CheckOutPageViewData

@section navbar {

}

<div>
	<form>
		<section id="RightSection" style="background-color: lightgray; flex: 1; padding: 20px; margin-top: 45px;">
			@foreach (var item in Basket.Products)
			{
				<p>@item.Brand</p>
				<p>@item.Description</p>
				<p>@item.PricePerDay DKK</p>
				<p>@item.StartDate @item.EndDate</p>
				<button asp-controller="Categories" asp-action="Remove" asp-route-id="@item.Id" asp-route-type="product">-</button>
				<p class="amount-text">@Basket.GetAmountOfSpecificProducts(item)</p>
				<button asp-controller="Categories" asp-action="Add" asp-route-id="@item.Id" asp-route-type ="product">+</button>

				<br>

				<br>
			}
			@foreach (var item in Basket.Packages)
			{
				<p>@item.Name</p>
				<p>@item.Description</p>
				<p>@item.TotalPricePerDay DKK</p>
				<button asp-controller="Categories" asp-action="Remove" asp-route-id="@item.id" asp-route-type="package">-</button>
				<p class="amount-text">@Basket.GetAmountOfSpecificPackages(item)</p>
				<button asp-controller="Categories" asp-action="Add" asp-route-id="@item.id" asp-route-type ="package">+</button><br><br>
			}
			<label>I alt</label>
			<p id="price-text">@Basket.GetTotalPricePerDay() DKK</p>
		</section>
	</form>
</div>

<style>
	label{
		font-weight: bold;
		font-size: 16px;
	}

	#checkbox {
		display: inline-block;
	}

	#terms-and-conditions {
		display: inline-block;
	}
</style>

@section Scripts{
    <script>

	</script>
}